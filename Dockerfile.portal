# ── Stage 1: Build ───────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/db/                  lib/db/
COPY lib/api-client-react/    lib/api-client-react/
COPY artifacts/portal/        artifacts/portal/

RUN pnpm install --frozen-lockfile

# Build arguments allow injecting VITE_ env vars at image build time
ARG VITE_BASE_URL=/

RUN pnpm --filter @workspace/portal run build

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

COPY --from=builder /workspace/artifacts/portal/dist/public /usr/share/nginx/html
COPY nginx.portal.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
