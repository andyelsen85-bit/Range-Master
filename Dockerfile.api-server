# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM node:22-slim AS builder

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.26.1 --activate

WORKDIR /repo

# Copy workspace manifests first for layer-cache efficiency
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./

# Copy all package.json files so pnpm can resolve the workspace graph
COPY artifacts/api-server/package.json ./artifacts/api-server/
COPY lib/ ./lib/

# Install all workspace dependencies (frozen for reproducibility)
RUN pnpm install --frozen-lockfile

# Copy the full source
COPY . .

# Build the API server bundle (produces dist/index.mjs + dist/migrate.mjs)
RUN pnpm --filter @workspace/api-server run build

# ── Stage 2: runner ───────────────────────────────────────────────────────────
FROM node:22-slim AS runner

ENV NODE_ENV=production
ENV PORT=8080

WORKDIR /app

# Compiled bundle
COPY --from=builder /repo/artifacts/api-server/dist ./dist

# Drizzle SQL migration files (used by dist/migrate.mjs at runtime)
COPY --from=builder /repo/lib/db/drizzle ./drizzle

EXPOSE 8080

CMD ["node", "dist/index.mjs"]
